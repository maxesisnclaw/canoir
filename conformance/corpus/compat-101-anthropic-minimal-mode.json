{
  "name": "Anthropic strict proxy minimal mode 移除非必要字段",
  "category": "compat",
  "operation": "anthropic-encode",
  "input": {
    "includeHeaders": true,
    "config": {
      "providerId": "provider-x",
      "model": "model-a",
      "endpoint": "https://endpoint-a.example/v1/messages",
      "apiKey": "test-key",
      "compatMode": "minimal",
      "headers": {
        "User-Agent": "sdk-client/1",
        "X-Stainless-Runtime": "js",
        "X-Custom": "keep"
      }
    },
    "options": {
      "system": "system",
      "stream": false,
      "tools": [
        {
          "name": "echo",
          "description": "echo text",
          "inputSchema": {
            "type": "object",
            "properties": { "text": { "type": "string" } },
            "required": ["text"]
          }
        }
