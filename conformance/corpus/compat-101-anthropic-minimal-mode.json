      "max_tokens": 32000,
      "messages": [
        { "role": "user", "content": [{ "type": "text", "text": "hello" }] }
      ],
      "stream": false,
      "system": "system",
      "tools": [
        {
          "name": "echo",
          "description": "echo text",
          "input_schema": {
            "type": "object",
            "properties": { "text": { "type": "string" } },
            "required": ["text"]
          }
        }
      ]
    },
    "headers": {
      "anthropic-version": "2023-06-01",
      "content-type": "application/json",
      "x-api-key": "test-key",
      "x-custom": "keep"
    }
  }
