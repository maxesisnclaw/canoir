{
  "name": "I9 Anthropic 1M 能力通过 beta header 而非 model 后缀",
  "category": "compat",
  "operation": "anthropic-encode",
  "recorded": false,
  "input": {
    "includeHeaders": true,
    "config": {
      "providerId": "provider-x",
      "model": "\u001b[31mmodel-a[1m]\u001b[0m",
      "endpoint": "https://endpoint-a.example/v1/messages",
      "apiKey": "test-key",
      "compatMode": "minimal",
      "contextWindowTokens": 1000000
    },
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "hello" }] }
    ]
  },
  "expected": {
    "body": {
      "model": "model-a",
      "max_tokens": 32000,
      "messages": [
        { "role": "user", "content": [{ "type": "text", "text": "hello" }] }
      ],
      "stream": true
    },
    "headers": {
      "anthropic-beta": "context-1m-2025-08-07",
      "anthropic-version": "2023-06-01",
      "content-type": "application/json",
      "x-api-key": "test-key"
    }
  }
}
