{
  "name": "Anthropic 编码省略空 text，保留 tool_use，丢弃仅空 text 的消息",
  "category": "structure",
  "operation": "anthropic-encode",
  "input": {
    "config": {
      "providerId": "provider-y",
      "model": "model-b",
      "endpoint": "https://endpoint-b.example/v1/messages",
      "apiKey": "test-key",
      "compatMode": "minimal"
    },
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "start" }] },
      {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "foreign",
            "signature": "sig-x",
            "providerId": "provider-x"
          },
          { "type": "text", "text": "" },
          { "type": "tool_call", "id": "call-1", "name": "lookup", "arguments": {} }
        ]
      },
      {
        "role": "tool",
        "content": [{ "type": "tool_result", "toolCallId": "call-1", "content": "" }]
      },
      { "role": "assistant", "content": [{ "type": "text", "text": "" }] },
      { "role": "user", "content": [{ "type": "text", "text": "continue" }] }
    ]
  },
  "expected": {
    "model": "model-b",
    "max_tokens": 32000,
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "start" }] },
      {
        "role": "assistant",
        "content": [
          { "type": "tool_use", "id": "call-1", "name": "lookup", "input": {} }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "call-1",
            "content": []
          },
          { "type": "text", "text": "continue" }
        ]
      }
    ],
    "stream": true
  }
}
